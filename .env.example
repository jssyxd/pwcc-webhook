# Set WEATHER_ENGINE_ENABLED=1 to enable the standalone observation engine.
# Without this and without UPSTREAM_BASE, the dashboard remains in demo mode.
# WEATHER_ENGINE_ENABLED=1

# Xweather Weather API credentials for station-level polling fallback.
# XWEATHER_CLIENT_ID=your_client_id
# XWEATHER_CLIENT_SECRET=your_client_secret
# Required safety gate: set to 1 only after an authenticated 41-station batch
# succeeds and X-Cost-* headers plus the Xweather usage console are acceptable.
# XWEATHER_BATCH_METERING_VERIFIED=0

# Optional protection for /api/weather/poll. Set the same value in Vercel.
# CRON_SECRET=replace-with-a-long-random-value

# Xweather Webhook verification. The current Xweather account is not subscribed
# to Webhooks; these variables must be populated only after Xweather provides
# the header names, signature scheme and/or registration configuration.
# XWEATHER_WEBHOOK_SIGNING_SECRET=vendor-provided-secret
# XWEATHER_WEBHOOK_SIGNATURE_HEADER=x-xweather-signature
# XWEATHER_WEBHOOK_SIGNATURE_PREFIX=sha256=
# XWEATHER_WEBHOOK_AUTH_TOKEN=vendor-provided-token
# XWEATHER_WEBHOOK_AUTH_HEADER=x-xweather-token
# XWEATHER_WEBHOOK_CHALLENGE_PARAM=challenge

# Existing read-only proxy mode. Used only when WEATHER_ENGINE_ENABLED is not 1.
# UPSTREAM_BASE=https://your-engine.example.com
# UPSTREAM_SECRET=your-bearer-token
# DEMO=1

# Optional dashboard access gate.
# ACCESS_PASSWORD=change-me
# AUTH_SECRET=change-me-too
